# Copy to .env.push and fill values for the push sender service
PUSH_SERVER_PORT=8787
PUSH_SERVER_API_KEY=

# VAPID keys for Web Push
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:you@example.com

# Firebase Admin credentials (use one option below)
# Option A: path to service-account JSON file
FIREBASE_SERVICE_ACCOUNT_FILE=

# Option B: raw JSON string of service-account credentials
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional explicit project id
FIREBASE_PROJECT_ID=

# Optional timezone handling for scheduled runs
REMINDER_TIMEZONE_OFFSET_HOURS=3

# --- Single-user push testing mode (optional) ---
# Set exactly one target identifier:
TEST_TARGET_USER_EMAIL="rahelly23@gmail.com"
TEST_TARGET_USER_ID="f75hyCblpxWTHutShs8C01s3m672"

# Testing flags for target user:
# true = allow repeat sends in the same day for the target user
TEST_TARGET_USER_REPEAT_PER_DAY=true
# true = ignore reminder time for the target user
TEST_TARGET_USER_IGNORE_TIME=false
# true = send even with no pending tasks for the target user
TEST_TARGET_USER_ALLOW_NO_TASKS=false

# --- Alternative datastore: Supabase (instead of Firebase Admin) ---
# If both SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are set,
# the push server will use Supabase PostgREST tables.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional table overrides (defaults shown):
SUPABASE_PUSH_SUBSCRIPTIONS_TABLE=PushSubscription
SUPABASE_NOTIFICATION_SETTINGS_TABLE=UserNotificationSettings
